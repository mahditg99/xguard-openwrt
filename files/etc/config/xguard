# xguard - transparent xray VPN for the whole router, with a fail-closed kill-switch
#
# enabled=0 by default: nothing is blocked or proxied until you add a node,
# choose interfaces and set enabled=1 (or use the web UI at /xguard/).

config main 'main'
	option enabled '0'
	# global policy for every client:  direct = nobody is proxied unless chosen (vpn interfaces/devices)
	#                                  vpn    = everybody is proxied unless exempted (direct interfaces/devices)
	option default_mode 'direct'
	# preferred node (section name). Failover walks the other enabled nodes in order.
	option node ''
	option log_level 'warning'
	# remote DNS used (through the tunnel) by dnsmasq. tcp:// is required for SSH nodes.
	option dns_remote 'tcp://1.1.1.1'
	option dns_port '15353'
	option redir_port '12345'
	option tproxy_port '12346'
	option socks_port '10808'
	option ssh_socks_port '10809'
	option metrics_port '11111'
	option probe_url 'https://www.gstatic.com/generate_204'
	option probe_interval '10'
	# consecutive dead probes before switching to the next node
	option fail_threshold '3'
	# Go soft memory limit for xray (MiB) and hard RSS limit before a restart (MiB)
	option mem_limit '28'
	option rss_kill '46'
	# enable xray sniffing; switched on automatically when `config bypass` contains a domain
	option sniffing '0'
	# optional resolver used outside the tunnel for the bypass domains only (e.g. 178.22.122.100)
	option dns_bypass ''
	# plain DNS used directly (not via the tunnel) only to resolve the host names of `source` entries
	# while xray is not running yet
	option bootstrap_dns '1.1.1.1 8.8.8.8'
	# interfaces facing the internet (traffic from vpn interfaces to these is dropped = kill-switch)
	list wan_if 'wan'
	# where the router downloads xray from (tried in order, forever):
	#   https://host/path/xray.gz      (+ xray.gz.sha256 next to it, sha256 of the *uncompressed* binary)
	#   ssh://user@host[:port]/xray.gz (OpenSSH, key /etc/xguard/id_ed25519)
	# list source 'https://example.com/xguard/xray.gz'

